{
  "name": "businessinfinity-asisaga",
  "type": "module",
  "version": "1.0.0",
  "description": "Business Infinity - Frontend for the Business Infinity app",
  "keywords": [
    "jekyll",
    "business-infinity",
    "boardroom",
    "web-components",
    "copilotkit"
  ],
  "scripts": {
    "lint:scss": "node lint-scss-mixins.js",
    "lint:scss:style": "stylelint \"_sass/**/*.scss\"",
    "lint:scss:raw-css": "node detect-raw-css.js",
    "sass:compile": "node compile-scss.js",
    "test:agui": "node --test tests/agui/*.test.js",
    "validate": "npm run lint:scss && npm run lint:scss:style && npm run lint:scss:raw-css && npm run sass:compile"
  },
  "author": "ASI Saga",
  "license": "MIT",
  "dependencies": {
    "@ag-ui/client": "^0.0.50",
    "@copilotkit/sdk-js": "^1.54.1",
    "js-yaml": "^4.1.1",
    "sass": "^1.97.1"
  },
  "devDependencies": {
    "postcss": "^8.4.49",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.10.0"
  }
}
