    { "type": "TEXT_MESSAGE_END", "messageId": "t2:founder" },
    { "type": "STEP_FINISHED", "stepName": "founder" },
    { "type": "STEP_STARTED", "stepName": "cfo" },
    { "type": "TEXT_MESSAGE_START", "messageId": "t2:cfo", "role": "assistant" },
    { "type": "TEXT_MESSAGE_CONTENT", "messageId": "t2:cfo", "delta": "Four months." },
    { "type": "TEXT_MESSAGE_END", "messageId": "t2:cfo" },
    { "type": "STEP_FINISHED", "stepName": "cfo" },
    { "type": "CUSTOM", "name": "resolution", "value": { "turn_id": "t2", "decision": "extend runway" } },
    { "type": "RUN_FINISHED", "threadId": "{{threadId}}", "runId": "{{runId}}", "result": { "turn_id": "t2", "decision": "extend runway" } }
  ],
  "turn_cancelled": [
    { "type": "RUN_STARTED", "threadId": "{{threadId}}", "runId": "{{runId}}" },
    { "type": "STEP_STARTED", "stepName": "cfo" },
    { "type": "TEXT_MESSAGE_START", "messageId": "t3:cfo", "role": "assistant" },
    { "type": "TEXT_MESSAGE_CONTENT", "messageId": "t3:cfo", "delta": "Runway is " },
