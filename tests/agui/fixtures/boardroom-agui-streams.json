    { "type": "TEXT_MESSAGE_END", "messageId": "t1:cfo" },
    { "type": "STEP_FINISHED", "stepName": "cfo" },
    { "type": "CUSTOM", "name": "position_stated", "value": { "actor": "cfo", "position": "support", "summary": "extend runway" } },
    { "type": "CUSTOM", "name": "resolution", "value": { "turn_id": "t1", "decision": "hold the price" } },
    { "type": "RUN_FINISHED", "threadId": "{{threadId}}", "runId": "{{runId}}", "result": { "turn_id": "t1", "decision": "hold the price" } }
  ],
  "turn_complete_two_speakers": [
