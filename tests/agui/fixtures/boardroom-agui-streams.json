    { "type": "RUN_FINISHED", "threadId": "{{threadId}}", "runId": "{{runId}}", "result": { "cancelled": true } }
  ],
  "turn_failed": [
    { "type": "RUN_STARTED", "threadId": "{{threadId}}", "runId": "{{runId}}" },
    { "type": "STEP_STARTED", "stepName": "cfo" },
    { "type": "TEXT_MESSAGE_START", "messageId": "t4:cfo", "role": "assistant" },
